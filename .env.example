NODE_ENV=development
PORT=8080

# PostgreSQL Database Connection (TLS Enforced via sslmode=require)
DATABASE_URL="postgresql://user:password@host:5432/krishi_vidhan_db?sslmode=require"

# JWT Security Configuration (Minimum 256-bit secret required)
JWT_SECRET="replace_with_a_cryptographically_random_secret_at_least_32_characters_long"
JWT_EXPIRES_IN="7d"

# Frontend CORS Origin
FRONTEND_URL="http://localhost:3000"

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

